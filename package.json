{
  "name": "identifAI",
  "displayName": "identifAI",
  "description": "this is an extension to identify autogenerated code",
  "publisher": "antquiher1",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "identifAI.deleteIAMap",
        "title": "delete information of AI map"
      },
      {
        "command": "identifAI.deletePartialInformation",
        "title": "delete information of AI in range"
      },
      {
        "command": "identifAI.showIAMap",
        "title": "show AI map in console"
      },
      {
        "command": "identifAI.returnIAMap",
        "title": "return AI Map"
      },
      {
        "command": "identifAI.returnColorWith",
        "title": "return Color with AI"
      },
      {
        "command": "identifAI.returnColorWithout",
        "title": "return Color with vs"
      },
      {
        "command": "identifAI.returnColorPasted",
        "title": "return Color pasted"
      },
      {
        "command": "identifAI.showDecorations",
        "title": "show decorations"
      },
      {
        "command": "identifAI.showDecorationsWithSpace",
        "title": "show decorations with AI"
      },
      {
        "command": "identifAI.showDecorationsWithoutSpace",
        "title": "show decorations with vs"
      },
      {
        "command": "identifAI.showDecorationsPasted",
        "title": "show decorations pasted"
      },
      {
        "command": "identifAI.hideDecorations",
        "title": "hide decorations"
      },
      {
        "command": "identifAI.hideDecorationsWithSpace",
        "title": "hide decorations with AI"
      },
      {
        "command": "identifAI.hideDecorationsWithoutSpace",
        "title": "hide decorations with vs"
      },
      {
        "command": "identifAI.hideDecorationsPasted",
        "title": "hide decorations pasted"
      }
  ],
  "viewsContainers": {
      "activitybar": [
        {
          "id": "IdentifAIContiner",
          "title": "IdentifAI",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "IdentifAIContiner": [
        {
          "id": "IdentifAI-change-bg",
          "name": "Change background color"
        },
        {
          "id": "IdentifAI-information",
          "name": "File information"
        },
        {
          "id": "IdentifAI-global-information",
          "name": "IdentifAI Global Information"
        },
        {
          "id": "IdentifAI-navigation",
          "name": "Navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}
